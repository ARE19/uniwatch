# Copy to .env (chmod 600) or run scripts/gen-env.sh, which fills every secret with a random value.
# Never commit .env.

APP_VERSION=dev

# --- Database -------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_NAME=uniwatch
# Owns the schema; used only by migrations.
DB_OWNER_USER=uniwatch_owner
DB_OWNER_PASSWORD=change-me
# Used by every running service. Not a superuser and not the table owner (needed for row-level security later).
DB_APP_USER=uniwatch_app
DB_APP_PASSWORD=change-me
# Web UI role: no direct access to log tables (scoped views only) and row-level security everywhere else.
DB_WEB_USER=uniwatch_web
DB_WEB_PASSWORD=change-me
DB_TUNE_MEMORY=8GB
DB_TUNE_CPUS=4

# --- Web ------------------------------------------------------------------
# Encrypts TOTP secrets at rest. Changing it invalidates every enrolled MFA device.
SECRET_KEY=change-me
COOKIE_SECURE=true
SESSION_MAX_HOURS=12
SESSION_IDLE_MINUTES=60
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_MINUTES=15
TOTP_ISSUER=Uniwatch
DEFAULT_TIMEZONE=Asia/Hong_Kong

# First admin, created by the migrate container only if no admin exists yet.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me

# --- Web address people use (links in alert e-mails / Teams; empty = no links) --
PUBLIC_URL=https://192.168.1.50

# --- Reports e-mail (leave SMTP_HOST empty to disable) ----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- DNS forwarder (website/app visibility) --------------------------------
DNS_BIND=192.168.1.50
DNS_UPSTREAM=192.168.1.1

# --- Caddy ----------------------------------------------------------------
# Comma-separated site addresses Caddy serves (certs from Caddy's internal CA).
SITE_ADDRESSES=https://localhost, https://192.168.1.50
# Certificate served to clients that connect by IP (no SNI). Use the address people browse to.
DEFAULT_SNI=192.168.1.50
# 127.0.0.1 = reachable from the server itself only. Set it to the server IP (e.g. 192.168.1.50) so users can reach the UI.
CADDY_BIND=127.0.0.1

# --- UniFi Site Manager (api.ui.com) read-only API key: fleet health of every console; empty = off ---
# Normally set in the portal instead (System Settings -> UniFi Site Manager); a key saved there replaces this one.
UNIFI_SITE_MANAGER_API_KEY=

# Where the nightly database backups go (default ./volumes/backups). Production: a separate disk.
# BACKUP_DIR=/backup/uniwatch

# --- Report packs (extra report types, Admin -> Report packs) -----------------
# Whose packs this installation accepts. Default: the Uniwatch publisher's key. Set your own (scripts/make_pack.py keygen)
# to publish packs yourself, or leave it empty to switch report packs off.
# PACK_PUBLIC_KEY=

# --- Branding of reports and alert e-mails (defaults: neutral Uniwatch) -----
# BRAND_COMPANY=Example MSP Ltd
# BRAND_SHORT=EXAMPLE MSP
# BRAND_ADDRESS=1 Example Street|Example City          (lines separated by |)
# BRAND_PHONES=T: +1 555 0100
# BRAND_CONFIDENTIAL=Example MSP - Confidential
# BRAND_COLOR=#1F6FB2   BRAND_COLOR_DARK=#123F66   BRAND_HEADING=#0F3D5E
# BRAND_ASSETS=/srv/brand    folder with logo.png (240 px), logo-email.png (96 px), optional cover.jpg; mount it into web/reporter/poller

# --- Misc -------------------------------------------------------------------
# Client (slug) under which the log server's own health alerts are filed: create a client for your MSP and put its slug here.
# PLATFORM_CLIENT_SLUG=msp
# When the consoles' own weekly backup files are copied (after the console makes them):
# FW_BACKUP_WEEKLY=sun 01:30 Asia/Hong_Kong
